# Generated by "bogform ci init". This file is yours to edit.
#
# To comment on merge requests, add a project access token with the api scope as a masked CI/CD
# variable named BOG_CI_TOKEN. Protect the "[[.Environment]]" environment to require approval to apply.

stages:
  - plan
  - apply

default:
  image:
    name: ghcr.io/bogware/bogform:[[.ImageTag]]
    entrypoint: [""]
  # Sign in to your cloud provider here, using OIDC rather than stored keys. For example:
  # id_tokens:
  #   AWS_WEB_IDENTITY_TOKEN:
  #     aud: https://gitlab.com

variables:
  BOGFORM_DIRECTORY: "[[.Directory]]"

bogform-plan:
  stage: plan
  resource_group: bogform
  rules:
    - if: $CI_PIPELINE_SOURCE == "merge_request_event"
  script:
    - bogform -chdir="$BOGFORM_DIRECTORY" ci plan
  artifacts:
    when: always
    paths:
      - $BOGFORM_DIRECTORY/.bogform-ci/report.json

bogform-apply:
  stage: apply
  resource_group: bogform
  environment: [[.Environment]]
  rules:
    - if: $CI_COMMIT_BRANCH == "[[.DefaultBranch]]" && $CI_PIPELINE_SOURCE != "merge_request_event"
  script:
    - bogform -chdir="$BOGFORM_DIRECTORY" ci apply
  artifacts:
    when: always
    paths:
      - $BOGFORM_DIRECTORY/.bogform-ci/report.json
