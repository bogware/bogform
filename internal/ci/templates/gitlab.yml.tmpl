# Generated by "bogform ci init". This file is yours to edit.
#
# To comment on merge requests, add a project access token with the api scope as a masked CI/CD
# variable named BOG_CI_TOKEN. Protect the "[[.Environment]]" environment to require approval to apply.
[[- if .GitState]]
#
# For the git state backend, add the state passphrase as a masked variable named
# BOGFORM_STATE_PASSPHRASE, which the passphrase key provider reads (or TF_VAR_state_passphrase, if the
# configuration passes it in as a variable), and give the job token permission to push to this project.
[[- end]]

stages:
  - plan
  - apply

default:
  image:
    name: ghcr.io/bogware/bogform:[[.ImageTag]]
    entrypoint: [""]
[[- if not (or .Plan.Any .Apply.Any)]]
  # Sign in to your cloud provider here, using OIDC rather than stored keys. For example:
  # id_tokens:
  #   AWS_WEB_IDENTITY_TOKEN:
  #     aud: https://gitlab.com
[[- end]]

variables:
  BOGFORM_DIRECTORY: "[[.Directory]]"
  # Applies refuse to destroy or replace resources unless this is "true". Set it when you run the
  # apply job.
  BOG_CI_ALLOW_DESTROY:
    value: "false"
    description: Set to "true" to apply a plan that destroys or replaces resources.

bogform-plan:
  stage: plan
  resource_group: bogform
[[- template "gitlab-signin" .Plan]]
  rules:
    - if: $CI_PIPELINE_SOURCE == "merge_request_event"
  script:
    - bogform -chdir="$BOGFORM_DIRECTORY" ci plan[[if .Cost]] -cost[[end]]
  artifacts:
    when: always
    paths:
      - $BOGFORM_DIRECTORY/.bogform-ci/report.json

bogform-apply:
  stage: apply
  resource_group: bogform
[[- template "gitlab-signin" .Apply]]
[[- if .Environment]]
  environment: [[.Environment]]
[[- end]]
  rules:
    - if: $CI_COMMIT_BRANCH == "[[.DefaultBranch]]" && $CI_PIPELINE_SOURCE != "merge_request_event"
[[- if eq .ApplyOn "manual"]]
      # Start this job from the pipeline page to apply.
      when: manual
[[- end]]
  script:
    - bogform -chdir="$BOGFORM_DIRECTORY" ci apply
  artifacts:
    when: always
    paths:
      - $BOGFORM_DIRECTORY/.bogform-ci/report.json
