# Generated by "bogform ci init". This file is yours to edit.
name: Bogform

on:
  pull_request:
[[- if eq .ApplyOn "merge"]]
  push:
    branches:
      - [[.DefaultBranch]]
[[- end]]
  workflow_dispatch:
    inputs:
      allow_destroy:
        description: Apply even if the plan destroys or replaces resources
        type: boolean
        default: false

# Only one run at a time can change this infrastructure.
concurrency:
  group: bogform-${{ github.ref }}
  cancel-in-progress: false

permissions:
  contents: read
[[- if .GitState]]

# The git backend keeps encrypted state on a branch of this repository. Store its passphrase as a secret.
env:
  TF_VAR_state_passphrase: ${{ secrets.BOGFORM_STATE_PASSPHRASE }}
[[- end]]

jobs:
  plan:
    name: Plan
    if: github.event_name == 'pull_request'
    runs-on: ubuntu-latest
    permissions:
[[- if .GitState]]
      contents: write # The git backend takes a lock by pushing a branch.
[[- else]]
      contents: read
[[- end]]
      pull-requests: write # To comment with the plan.
      id-token: write # For cloud access using OIDC.
    steps:
      - uses: actions/checkout@v7
[[- template "github-signin" .Plan]]
      - uses: bogware/bogform@[[.ActionRef]]
[[- template "github-arm-env" .Plan]]
        with:
          version: [[.ReleaseVersion]]
          command: plan
          working-directory: [[.Directory]]
[[- if .Cost]]
          args: -cost
[[- end]]
          # If you run a Bogform dashboard:
          # server-url: https://bogform.example.com
          # server-token: ${{ secrets.BOG_SERVER_TOKEN }}

  apply:
    name: Apply
[[- if eq .ApplyOn "merge"]]
    # Applies every change merged to [[.DefaultBranch]].
    if: github.event_name != 'pull_request' && github.ref == 'refs/heads/[[.DefaultBranch]]'
[[- else]]
    # Applies only when someone starts this workflow from the Actions tab, on [[.DefaultBranch]].
    if: github.event_name == 'workflow_dispatch' && github.ref == 'refs/heads/[[.DefaultBranch]]'
[[- end]]
    runs-on: ubuntu-latest
[[- if .Environment]]
    # On plans that support it, add required reviewers to this environment to approve each apply.
    environment: [[.Environment]]
[[- end]]
    permissions:
[[- if .GitState]]
      contents: write # The git backend stores state by pushing to a branch.
[[- else]]
      contents: read
[[- end]]
      pull-requests: read # To check the merged pull request for the allow-destroy label.
      id-token: write # For cloud access using OIDC.
    steps:
      - uses: actions/checkout@v7
[[- template "github-signin" .Apply]]
      - uses: bogware/bogform@[[.ActionRef]]
[[- template "github-arm-env" .Apply]]
        with:
          version: [[.ReleaseVersion]]
          command: apply
          working-directory: [[.Directory]]
          # Applies refuse to destroy or replace resources unless the merged pull request has the
          # allow-destroy label, or someone runs this workflow with "allow destroy" ticked.
          args: ${{ inputs.allow_destroy && '-allow-destroy' || '' }}
          # If you run a Bogform dashboard:
          # server-url: https://bogform.example.com
          # server-token: ${{ secrets.BOG_SERVER_TOKEN }}
