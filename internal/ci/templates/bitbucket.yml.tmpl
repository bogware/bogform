# Generated by "bogform ci init". This file is yours to edit.
#
# To comment on pull requests, add an access token with pull request write access as a secured
# repository variable named BOG_CI_TOKEN.
[[- if .GitState]]
#
# For the git state backend, add the state passphrase as a secured variable named
# BOGFORM_STATE_PASSPHRASE, which the passphrase key provider reads (or TF_VAR_state_passphrase, if the
# configuration passes it in as a variable), and set "repository" in the backend to a URL with an
# access token that can push.
[[- end]]

image:
  name: ghcr.io/bogware/bogform:[[.ImageTag]]

pipelines:
  pull-requests:
    "**":
      - step:
          name: Plan
[[- template "bitbucket-oidc" .Plan]]
          script:
[[- template "bitbucket-signin" .Plan]]
            - bogform -chdir="[[.Directory]]" ci plan[[if .Cost]] -cost[[end]]
          artifacts:
            - "[[.Directory]]/.bogform-ci/report.json"
[[- if eq .ApplyOn "merge"]]
  # Applies refuse to destroy or replace resources. To allow it for a change, set a BOG_CI_ALLOW_DESTROY
  # repository variable to "true" before merging, and remove it afterwards.
  branches:
    [[.DefaultBranch]]:
      - step:
          name: Apply
[[- if .Environment]]
          deployment: [[.Environment]]
[[- end]]
[[- template "bitbucket-oidc" .Apply]]
          script:
[[- template "bitbucket-signin" .Apply]]
            - bogform -chdir="[[.Directory]]" ci apply
          artifacts:
            - "[[.Directory]]/.bogform-ci/report.json"
[[- else]]
  # To apply, run the "apply" pipeline on [[.DefaultBranch]] from the Pipelines page.
  custom:
    apply:
      # Applies refuse to destroy or replace resources unless this is "true" when the pipeline runs.
      - variables:
          - name: BOG_CI_ALLOW_DESTROY
            default: "false"
            allowed-values:
              - "false"
              - "true"
      - step:
          name: Apply
[[- if .Environment]]
          deployment: [[.Environment]]
[[- end]]
[[- template "bitbucket-oidc" .Apply]]
          script:
[[- template "bitbucket-signin" .Apply]]
            - bogform -chdir="[[.Directory]]" ci apply
          artifacts:
            - "[[.Directory]]/.bogform-ci/report.json"
[[- end]]
