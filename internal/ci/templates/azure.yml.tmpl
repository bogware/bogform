# Generated by "bogform ci init". This file is yours to edit.
#
# For plans on pull requests, add this pipeline as a build validation policy on your default branch.
# To comment, allow the build service to contribute to pull requests in the repository's security
# settings. Add an approval check to the "[[.Environment]]" environment to approve each apply.

trigger:
  branches:
    include:
      - [[.DefaultBranch]]

pr: none

pool:
  vmImage: ubuntu-latest

variables:
  bogformVersion: [[.ReleaseVersion]]
  bogformDirectory: "[[.Directory]]"

stages:
  - stage: Plan
    condition: eq(variables['Build.Reason'], 'PullRequest')
    jobs:
      - job: Plan
        steps:
          - checkout: self
          - bash: |
              set -euo pipefail
              repo=https://github.com/bogware/bogform
              version="$(bogformVersion)"
              if [ "$version" = latest ]; then
                version="$(curl -fsSL -o /dev/null -w '%{url_effective}' "$repo/releases/latest")"
                version="${version##*/v}"
              fi
              base="$repo/releases/download/v$version"
              archive="bogform_${version}_linux_amd64.tar.gz"
              curl -fsSLO "$base/$archive"
              curl -fsSLO "$base/bogform_${version}_SHA256SUMS"
              sha256sum --ignore-missing -c "bogform_${version}_SHA256SUMS"
              mkdir -p "$(Agent.TempDirectory)/bogform"
              tar -xzf "$archive" -C "$(Agent.TempDirectory)/bogform" bogform
              echo "##vso[task.prependpath]$(Agent.TempDirectory)/bogform"
            displayName: Install Bogform
          # Sign in to your cloud provider here, using a workload identity service connection. An
          # AzureCLI@2 task with addSpnToEnvironment: true can make its identity available.
          - bash: bogform -chdir="$(bogformDirectory)" ci plan
            displayName: Plan
            env:
              BOG_CI_TOKEN: $(System.AccessToken)

  - stage: Apply
    # Stages depend on the previous one by default, and Plan is skipped outside pull requests.
    dependsOn: []
    condition: and(succeeded(), ne(variables['Build.Reason'], 'PullRequest'), eq(variables['Build.SourceBranch'], 'refs/heads/[[.DefaultBranch]]'))
    jobs:
      - deployment: Apply
        environment: [[.Environment]]
        strategy:
          runOnce:
            deploy:
              steps:
                - checkout: self
                - bash: |
                    set -euo pipefail
                    repo=https://github.com/bogware/bogform
                    version="$(bogformVersion)"
                    if [ "$version" = latest ]; then
                      version="$(curl -fsSL -o /dev/null -w '%{url_effective}' "$repo/releases/latest")"
                      version="${version##*/v}"
                    fi
                    base="$repo/releases/download/v$version"
                    archive="bogform_${version}_linux_amd64.tar.gz"
                    curl -fsSLO "$base/$archive"
                    curl -fsSLO "$base/bogform_${version}_SHA256SUMS"
                    sha256sum --ignore-missing -c "bogform_${version}_SHA256SUMS"
                    mkdir -p "$(Agent.TempDirectory)/bogform"
                    tar -xzf "$archive" -C "$(Agent.TempDirectory)/bogform" bogform
                    echo "##vso[task.prependpath]$(Agent.TempDirectory)/bogform"
                  displayName: Install Bogform
                # Sign in to your cloud provider here.
                - bash: bogform -chdir="$(bogformDirectory)" ci apply
                  displayName: Apply
